{
  "permissions": {
    "allow": [
      "Bash(npm run compile)",
      "Bash(npm run watch)",
      "Bash(npm run lint)",
      "Bash(npm install*)",
      "Bash(npx tsc*)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc --noEmit 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}
